layout {

    focus-ring {
        active-color   "#242916"
        inactive-color "#fcf9f5"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#242916"
        inactive-color "#fcf9f5"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#242916"
        inactive-color "#3a3f2a"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#24291680"
    }
}

recent-windows {
    highlight {
        active-color "#242916"
        urgent-color "#ba1a1a"
    }
}
