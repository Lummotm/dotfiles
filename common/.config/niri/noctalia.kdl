layout {

    focus-ring {
        active-color   "#d5c4b2"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d5c4b2"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#d5c4b2"
        inactive-color "#9e8e7e"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d5c4b280"
    }
}

recent-windows {
    highlight {
        active-color "#d5c4b2"
        urgent-color "#ffb4ab"
    }
}
