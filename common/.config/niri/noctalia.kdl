layout {

    focus-ring {
        active-color   "#aac8fa"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#aac8fa"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#aac8fa"
        inactive-color "#54729f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#aac8fa80"
    }
}

recent-windows {
    highlight {
        active-color "#aac8fa"
        urgent-color "#ffb4ab"
    }
}
