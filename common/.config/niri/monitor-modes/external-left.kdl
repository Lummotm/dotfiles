output "HDMI-A-1" {
    mode "1920x1080@144"
    position x=0 y=0
    scale 1
    focus-at-startup
    //transform "90"
}

output "DP-1" {
    mode "1920x1080@144"
    position x=0 y=0 
    scale 1
    focus-at-startup
    //transform "90"
}

output "eDP-1" {
    mode "1920x1080@60"
    position x=1920 y=0
    scale 1
}
