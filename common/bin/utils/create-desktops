# UTILIDADES VDF (Aplicar propiedades especificas de juegos: Proton, launch options, ...)


def find_appid_block(content, appid, search_from=0):
    # Localiza el bloque del juego exacto dentro del archivo VDF
    pattern = rf'\n\t+"{appid}"\n\t+\{{'
    match = re.search(pattern, content[search_from:])
    if not match:
        return None, None

    brace_start = search_from + match.end() - 1
    depth = 0
    for i in range(brace_start, len(content)):
        if content[i] == "{":
            depth += 1
        elif content[i] == "}":
            depth -= 1
            if depth == 0:
                return brace_start, i
    return None, None


def set_root_launch_options(block, options):
    # Inserta las LaunchOptions solo en el nivel principal del bloque
    result = []
    depth = 0
    launch_options_replaced = False
    final_options = options if "%command%" in options else f"{options} %command%"

    for line in block.split("\n"):
        depth += line.count("{") - line.count("}")
        if depth == 1 and '"LaunchOptions"' in line and not launch_options_replaced:
            indent = re.match(r"(\s*)", line).group(1)
            result.append(f'{indent}"LaunchOptions"\t\t"{final_options}"')
            launch_options_replaced = True
        else:
            result.append(line)

    if not launch_options_replaced:
        result.insert(-1, f'\t\t\t\t\t\t"LaunchOptions"\t\t"{final_options}"')

    return "\n".join(result)


def set_launch_options_vdf(appid, options):
    userdata = Path("~/.local/share/Steam/userdata/").expanduser()
    vdf_path = max(
        userdata.rglob("localconfig.vdf"), key=lambda p: p.stat().st_mtime, default=None
    )
    if not vdf_path:
        return

    # Backup del config (se ejecuta solo una vez por script)
    if not hasattr(set_launch_options_vdf, "_backup_done"):
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        shutil.copy(vdf_path, vdf_path.with_name(f"localconfig.vdf.bak_{timestamp}"))
        set_launch_options_vdf._backup_done = True

    content = vdf_path.read_text(encoding="utf-8")
    software_pos = content.find('"Software"')
    if software_pos == -1:
        return

    brace_start, brace_end = find_appid_block(content, appid, search_from=software_pos)
    if brace_start is None:
        return

    block = content[brace_start : brace_end + 1]
    new_block = set_root_launch_options(block, options)
    vdf_path.write_text(
        content[:brace_start] + new_block + content[brace_end + 1 :], encoding="utf-8"
    )


def apply_special_launch_options():
    for appid, special in SPECIAL_CASES.items():
        if "launch_options" in special:
            set_launch_options_vdf(appid, special["launch_options"])


# LISTADO RAPIDO de juegos de steam


def list_steam_names():
    for dir in STEAM_DIRS:
        steam_dir = Path(dir).expanduser()
        if not steam_dir.exists():
            continue

        for filepath in steam_dir.glob("appmanifest_*.acf"):
            name = appid = None
            with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    if '"name"' in line:
                        name = line.split('"')[3]
                    if '"appid"' in line:
                        appid = line.split('"')[3]
            if name and appid:
                print(f"{appid:<12} | {name}")


# STEAM: creacion de accesos directos (.desktop)


def create_steam_desktop_file(name, appid):
    filename = f"{name}.desktop"
    filedir = STEAM_APPLICATIONS_DIR / filename

    if filedir.exists():
        return

    exec_command = f"steam steam://rungameid/{appid}"
    file_string = (
        f"[Desktop Entry]\nName={name}\nExec={exec_command}\n"
        f"StartupWMClass=steam_app_{appid}\nIcon=steam_icon_{appid}\n"
        f"Terminal=false\nType=Application\nCategories=Game;\n"
    )

    with open(filedir, "w") as f:
        f.write(file_string)


def process_steam_games():
    """Escanea las bibliotecas de Steam y genera un .desktop por cada juego."""
    if STEAM_APPLICATIONS_DIR.exists() and STEAM_APPLICATIONS_DIR.is_dir():
        rmtree(STEAM_APPLICATIONS_DIR)
    STEAM_APPLICATIONS_DIR.mkdir(exist_ok=True, parents=True)

    for dir in STEAM_DIRS:
        steam_dir = Path(dir).expanduser()

        if not steam_dir.exists():
            continue

        for filepath in steam_dir.glob("appmanifest_*.acf"):
            name = appid = None
            with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    if '"name"' in line:
                        name = line.split('"')[3]
                    if '"appid"' in line:
                        appid = line.split('"')[3]
            if name and appid and appid not in EXCLUDED_APPIDS:
                create_steam_desktop_file(name, appid)

    apply_special_launch_options()


# STEAM: procesado de iconos


def process_and_get_icon(appid):
    if (OBJECTIVE_ICON_BASE / "256x256" / "apps" / f"steam_icon_{appid}.png").exists():
        return

    source_file = next(
        (
            p
            for ext in ["png", "jpg", "ico", "svg"]
            if (p := MANUAL_ICON_SOURCE / f"{appid}.{ext}").exists()
        ),
        None,
    )
    if not source_file:
        return

    for size in ICON_SIZES:
        dim = size.split("x")[0]
        target_path = OBJECTIVE_ICON_BASE / size / "apps" / f"steam_icon_{appid}.png"
        target_path.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            [
                "ffmpeg",
                "-y",
                "-i",
                str(source_file),
                "-vf",
                f"scale={dim}:{dim}:force_original_aspect_ratio=decrease,pad={dim}:{dim}:(ow-iw)/2:(oh-ih)/2:color=black@0",
                str(target_path),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def backup_high_res_icons():
    found_icons = {}
    for size in reversed(ICON_SIZES):
        size_folder = OBJECTIVE_ICON_BASE / size / "apps"
        if not size_folder.exists():
            continue
        for icon_path in size_folder.glob("steam_icon_*.png"):
            appid = icon_path.stem.replace("steam_icon_", "")
            if appid not in found_icons:
                found_icons[appid] = icon_path

    for appid, icon_path in found_icons.items():
        if not any(
            (MANUAL_ICON_SOURCE / f"{appid}.{ext}").exists()
            for ext in ["png", "jpg", "ico", "svg"]
        ):
            subprocess.run(
                ["cp", str(icon_path), str(MANUAL_ICON_SOURCE / f"{appid}.png")]
            )


def process_steam_icons():
    """Genera los iconos en todos los tamanios y respalda los de alta resolucion."""
    MANUAL_ICON_SOURCE.mkdir(exist_ok=True, parents=True)

    if MANUAL_ICON_SOURCE.exists():
        for filepath in MANUAL_ICON_SOURCE.iterdir():
            if filepath.is_file():
                process_and_get_icon(filepath.stem)

    backup_high_res_icons()


# ATLAUNCHER: creacion de accesos directos a partir de instance.json


def sanitize_filename(name):
    """Convierte el nombre real de la instancia en un nombre de archivo seguro."""
    safe_name = name.lower()
    safe_name = re.sub(r"[^a-z0-9]+", "-", safe_name)
    safe_name = safe_name.strip("-")
    return safe_name or "instancia"


def create_atlauncher_desktop_file(name):
    safe_filename = sanitize_filename(name)
    filedir = DESKTOP_APPLICATIONS_DIR / f"atlauncher-{safe_filename}.desktop"

    exec_command = f'atlauncher --launch="{name}"'

    file_string = (
        f"[Desktop Entry]\n"
        f"Type=Application\n"
        f"Name={name}\n"
        f"Exec={exec_command}\n"
        f"Icon=atlauncher\n"
        f"Terminal=false\n"
        f"Categories=Game;Minecraft;\n"
    )

    with open(filedir, "w") as f:
        f.write(file_string)


def process_atlauncher_instances():
    """Escanea las instancias de ATLauncher y genera un .desktop por cada una."""
    if not ATLAUNCHER_INSTANCES_DIR.exists():
        return

    DESKTOP_APPLICATIONS_DIR.mkdir(exist_ok=True, parents=True)

    for instance_dir in ATLAUNCHER_INSTANCES_DIR.iterdir():
        if not instance_dir.is_dir():
            continue

        instance_json = instance_dir / "instance.json"
        if not instance_json.exists():
            continue

        try:
            with open(instance_json, "r", encoding="utf-8", errors="ignore") as f:
                data = json.load(f)
        except (json.JSONDecodeError, OSError):
            continue

        name = data.get("launcher", {}).get("name")
        if not name:
            continue

        create_atlauncher_desktop_file(name)


def main():
    if "--list-names" in sys.argv:
        list_steam_names()
        sys.exit(0)

    process_steam_games()
    process_steam_icons()
    process_atlauncher_instances()


if __name__ == "__main__":
    main()
