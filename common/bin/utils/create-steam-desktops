def create_files(name, appid):
    filename = f"{name}.desktop"
    filedir = steam_applications / filename

    if filedir.exists():
        return

    exec_command = f"steam steam://rungameid/{appid}"
    file_string = (
        f"[Desktop Entry]\nName={name}\nExec={exec_command}\n"
        f"StartupWMClass=steam_app_{appid}\nIcon=steam_icon_{appid}\n"
        f"Terminal=false\nType=Application\nCategories=Game;\n"
    )

    with open(filedir, "w") as f:
        f.write(file_string)


def find_appid_block(content, appid, search_from=0):
    # Localiza el bloque del juego exacto dentro del archivo VDF
    pattern = rf'\n\t+"{appid}"\n\t+\{{'
    match = re.search(pattern, content[search_from:])
    if not match:
        return None, None

    brace_start = search_from + match.end() - 1
    depth = 0
    for i in range(brace_start, len(content)):
        if content[i] == "{":
            depth += 1
        elif content[i] == "}":
            depth -= 1
            if depth == 0:
                return brace_start, i
    return None, None


def set_root_launch_options(block, options):
    # Inserta las LaunchOptions solo en el nivel principal del bloque
    result = []
    depth = 0
    launch_options_replaced = False
    final_options = options if "%command%" in options else f"{options} %command%"

    for line in block.split("\n"):
        depth += line.count("{") - line.count("}")
        if depth == 1 and '"LaunchOptions"' in line and not launch_options_replaced:
            indent = re.match(r"(\s*)", line).group(1)
            result.append(f'{indent}"LaunchOptions"\t\t"{final_options}"')
            launch_options_replaced = True
        else:
            result.append(line)

    if not launch_options_replaced:
        result.insert(-1, f'\t\t\t\t\t\t"LaunchOptions"\t\t"{final_options}"')

    return "\n".join(result)


def set_launch_options_vdf(appid, options):
    userdata = Path("~/.local/share/Steam/userdata/").expanduser()
    vdf_path = max(
        userdata.rglob("localconfig.vdf"), key=lambda p: p.stat().st_mtime, default=None
    )
    if not vdf_path:
        return

    # Backup del config (se ejecuta solo una vez por script)
    if not hasattr(set_launch_options_vdf, "_backup_done"):
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        shutil.copy(vdf_path, vdf_path.with_name(f"localconfig.vdf.bak_{timestamp}"))
        set_launch_options_vdf._backup_done = True

    content = vdf_path.read_text(encoding="utf-8")
    software_pos = content.find('"Software"')
    if software_pos == -1:
        return

    brace_start, brace_end = find_appid_block(content, appid, search_from=software_pos)
    if brace_start is None:
        return

    block = content[brace_start : brace_end + 1]
    new_block = set_root_launch_options(block, options)
    vdf_path.write_text(
        content[:brace_start] + new_block + content[brace_end + 1 :], encoding="utf-8"
    )


def process_and_get_icon(appid):
    if (objective_icon_base / "256x256" / "apps" / f"steam_icon_{appid}.png").exists():
        return

    source_file = next(
        (
            p
            for ext in ["png", "jpg", "ico", "svg"]
            if (p := manual_icon_source / f"{appid}.{ext}").exists()
        ),
        None,
    )
    if not source_file:
        return

    for size in SIZES:
        dim = size.split("x")[0]
        target_path = objective_icon_base / size / "apps" / f"steam_icon_{appid}.png"
        target_path.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            [
                "ffmpeg",
                "-y",
                "-i",
                str(source_file),
                "-vf",
                f"scale={dim}:{dim}:force_original_aspect_ratio=decrease,pad={dim}:{dim}:(ow-iw)/2:(oh-ih)/2:color=black@0",
                str(target_path),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def backup_high_res_icons():
    found_icons = {}
    for size in reversed(SIZES):
        size_folder = objective_icon_base / size / "apps"
        if not size_folder.exists():
            continue
        for icon_path in size_folder.glob("steam_icon_*.png"):
            appid = icon_path.stem.replace("steam_icon_", "")
            if appid not in found_icons:
                found_icons[appid] = icon_path

    for appid, icon_path in found_icons.items():
        if not any(
            (manual_icon_source / f"{appid}.{ext}").exists()
            for ext in ["png", "jpg", "ico", "svg"]
        ):
            subprocess.run(
                ["cp", str(icon_path), str(manual_icon_source / f"{appid}.png")]
            )


