#!/usr/bin/env python
# From https://github.com/Marco98/rofi-mpc

import os
import sys
from html import escape
from subprocess import PIPE, Popen, check_call, check_output

ENGINE = os.environ.get("ROFI_ENGINE", "rofi")


def run_menu(options_str, prompt="Select: ", mesg=None, selected_row=None):
    cmd = [ENGINE]

    if ENGINE == "tofi":
        if mesg:
            options_str = f"--- {mesg} ---\n" + options_str
        if prompt:
            cmd.extend(["--prompt-text", prompt])
    else:
        cmd.extend(["-i", "-dmenu"])
        if prompt:
            cmd.extend(["-p", prompt])
        if mesg:
            cmd.extend(["-mesg", mesg])
        if selected_row is not None:
            cmd.extend(["-selected-row", str(selected_row)])

    proc = Popen(cmd, stdout=PIPE, stdin=PIPE)
    stdout, _ = proc.communicate(input=options_str.encode())
    return stdout.decode().rstrip()


def get_current_title():
    return check_output(["mpc", "-f", "%title%", "current"]).decode().strip()


def get_playlist_len():
    length = len(check_output(["mpc", "playlist"]).decode().strip().splitlines())
    return str(length)


def show_sources():
    source_options = f"{OPT_PLAYLISTS}\n{OPT_ALBUMS}\n{OPT_ARTISTS}\n{OPT_ALL_SONGS}"

    source_selection = run_menu(
        source_options, prompt="Search by: ", mesg=current_track
    )

    if not source_selection:
        sys.exit(0)

    elif source_selection == OPT_ALBUMS:
        albums = check_output(["mpc", "list", "album"]).decode()
        chosen_album = run_menu(albums, prompt="Choose Album: ")

        if chosen_album:
            check_call(["mpc", "findadd", "album", chosen_album])
            check_call(["mpc", "play"])

    elif source_selection == OPT_ARTISTS:
        artists = check_output(["mpc", "list", "artist"]).decode()
        chosen_artist = run_menu(artists, prompt="Choose Artist: ")

        if chosen_artist:
            check_call(["mpc", "findadd", "artist", chosen_artist])
            check_call(["mpc", "play"])

    elif source_selection == OPT_ALL_SONGS:
        files = check_output(["mpc", "listall"]).decode()
        all_menu = f"{OPT_PLAY_ALL}\n" + files

        chosen_song = run_menu(all_menu, prompt="Search Song: ")

        if chosen_song == OPT_PLAY_ALL:
            check_call(["mpc", "update"])
            add = Popen(["mpc", "add"], stdin=PIPE)
            add.communicate(files.encode())
            Popen(["mpc", "play"])
        elif chosen_song:
            check_call(["mpc", "add", chosen_song])
            current_length = get_playlist_len()
            check_call(["mpc", "play", current_length])

    elif source_selection == OPT_PLAYLISTS:
        raw_output = check_output(["mpc", "lsplaylists"], text=True)
        clean_playlists = [
            line
            for line in raw_output.splitlines()
            if line.strip() and line.strip() != "tmp.m3u"
        ]

        playlists_input = "\n".join(clean_playlists)
        chosen_pl = run_menu(playlists_input, prompt="Playlist: ")

        if chosen_pl:
            pl_name = chosen_pl.replace(".m3u", "")
            check_call(["mpc", "load", pl_name])
            check_call(["mpc", "play"])


current_track = get_current_title()
status_output = check_output(["mpc"]).decode()

if not current_track:
    current_track = "Nothing is currently playing"
else:
    if "paused" not in status_output:
        current_track = "Currently Playing: " + escape(current_track)
    else:
        current_track = "Paused: " + escape(current_track)

RANDOM = "󰒝 Random: On" if "random: on" in status_output else "󰒝 Random: Off"
REPEAT = "󰑖 Repeat: On" if "repeat: on" in status_output else "󰑖 Repeat: Off"
CONSUME = "󱃘 Consume: On" if "consume: on" in status_output else "󱃘 Consume: Off"

TOGGLE = "󰐎 Play/Pause"
NEXT = "󰒭 Next"
PREV = "󰒮 Prev"
STOP = "󰛉 Clear"
LIST = " List"

OPT_ALBUMS = " Albums"
OPT_ARTISTS = "󰀉 Artists"
OPT_PLAYLISTS = "󰐑 Playlists"
OPT_ALL_SONGS = " All Songs"
OPT_PLAY_ALL = "[Play All]"

playlist_length = get_playlist_len()

if playlist_length == "0":
    selection = "SOURCES"
else:
    menu_options = [
        LIST,
        TOGGLE,
        NEXT,
        PREV,
        STOP,
        REPEAT,
        RANDOM,
        CONSUME,
        "Volume 25%",
        "Volume 50%",
        "Volume 75%",
        "Volume 100%",
    ]
    commands = "\n".join(menu_options)

    selection = run_menu(commands, mesg=current_track, selected_row=1)

if selection == TOGGLE:
    check_call(["mpc", "toggle"])
elif selection == NEXT:
    check_call(["mpc", "next"])
elif selection == PREV:
    check_call(["mpc", "prev"])
elif selection == STOP:
    check_call(["mpc", "stop"])
    check_call(["mpc", "clear"])
elif selection == RANDOM:
    check_call(["mpc", "random"])
elif selection == REPEAT:
    check_call(["mpc", "repeat"])
elif selection == CONSUME:
    check_call(["mpc", "consume"])
elif "Volume" in selection:
    vol = selection.split(" ")[1].replace("%", "")
    check_call(["mpc", "volume", vol])

elif selection == LIST:
    titles = check_output(["mpc", "playlist"]).decode()
    track_count = 0
    track_list = ""
    for line in titles.splitlines():
        track_count += 1
        track_list += f"[{track_count}] {line}\n"

    if track_count > 1:
        track_list = "[SOURCES]\n" + track_list.rstrip()

        selection = run_menu(track_list, prompt="Play: ", selected_row=0)
        selection = selection[selection.find("[") + 1 : selection.find("]")]
    else:
        selection = "SOURCES"

    if not selection:
        sys.exit(0)

if selection == "SOURCES":
    show_sources()
elif selection and selection != "SOURCES":
    check_call(["mpc", "play", selection])
