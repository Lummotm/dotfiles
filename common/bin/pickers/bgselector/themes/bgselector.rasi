    // Global
* {
    background-color: transparent;
}

// Window
window {
    background-color: rgba(0,0,0,0.7);
    fullscreen: true;    
}

// Main Box
mainbox {
    children: [listview];
    padding: 25% 0%; 
}

// Listview
listview {
    padding: 0px 10px;
    spacing: 10px;
    columns: 4;
    flow: horizontal;
    children: [element-icon];
}
element {
    border-radius: 10px;
}
element.selected {
    border: 2px;
    border-color: white;
}
element-icon {
    // 1080 / 2 = 540px thats why
    // 540px seem the max on height more than that makes all black       
    size: 529px 540px;
    horizontal-align: 0;
    vertical-align: 0.5;
}
