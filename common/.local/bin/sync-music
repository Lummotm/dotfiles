#!/usr/bin/env bash
# sync-music: perfil de música para termux-sync
set -euo pipefail

show_profile_help() {
  cat <<EOF
sync-music - Sincroniza ~/Music con ~/storage/music en Termux usando termux-sync.

USO
  sync-music [IP] [PUERTO] [--dir=1|2] [--delete] [--dry-run]

  --dir=1   PC -> Móvil. Ejecuta el script de playlists antes de subir.
  --dir=2   Móvil -> PC. Ejecuta el script de playlists después de bajar.
  Si no se indica --dir, lo pregunta.

VALORES POR DEFECTO (sobreescribibles con variables de entorno)
  USER_TERMUX   u0_a308
  LOCAL_DIR     \$HOME/Music
  REMOTE_DIR    ~/storage/music

EXCLUDES FIJOS
  Merlin, .thumbnails, .data, .cover

Para ver todas las opciones del motor: termux-sync --help
EOF
}

for a in "$@"; do
  case "$a" in
  -h | --help)
    show_profile_help
    exit 0
    ;;
  esac
done

# ---------------------------------------------------------------------------
# Configuración del perfil
# ---------------------------------------------------------------------------
export USER_TERMUX="${USER_TERMUX:-u0_a308}"
LOCAL_DIR="${LOCAL_DIR:-$HOME/Music}"
REMOTE_DIR="${REMOTE_DIR:-~/storage/music}"
FIX_PY="$HOME/bin/utils/music-playlist-fix.py"
PLAYLISTS="$HOME/Music/0-playlists/*.m3u"

# ---------------------------------------------------------------------------
# Parseo de argumentos
# ---------------------------------------------------------------------------
IP=""
PORT=""
DIR=""
PASS=()

for arg in "$@"; do
  case "$arg" in
  --dir=*) DIR="${arg#--dir=}" ;;
  --delete | --dry-run) PASS+=("$arg") ;;
  *)
    if [[ "$arg" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      IP="$arg"
    elif [[ "$arg" =~ ^[0-9]+$ ]]; then
      PORT="$arg"
    else
      echo "Argumento desconocido: '$arg'. Usa --help."
      exit 1
    fi
    ;;
  esac
done

# ---------------------------------------------------------------------------
# Sentido: argumento o pregunta
# ---------------------------------------------------------------------------
if [ -z "$DIR" ]; then
  echo "Dirección de sincronización:"
  echo "1) PC -> Móvil"
  echo "2) Móvil -> PC"
  read -rp "Opción (1 o 2): " DIR
fi

# ---------------------------------------------------------------------------
# Hooks específicos de música
# chmod se aplica antes y después. El script de playlists va antes de subir
# (dir 1) o después de bajar (dir 2), para que los cambios lleguen al destino.
# ---------------------------------------------------------------------------
CHMOD_CMD="chmod 644 $PLAYLISTS 2>/dev/null || true"
FIX_CMD="python3 '$FIX_PY' --silent"

case "$DIR" in
1)
  PRE="$CHMOD_CMD; $FIX_CMD"
  POST="$CHMOD_CMD"
  ;;
2)
  PRE="$CHMOD_CMD"
  POST="$FIX_CMD; $CHMOD_CMD"
  ;;
*)
  echo "Opción no válida: '$DIR'. Usa 1 o 2."
  exit 1
  ;;
esac

# ---------------------------------------------------------------------------
# Llamada al motor
# ---------------------------------------------------------------------------
exec termux-sync \
  ${IP:+"$IP"} ${PORT:+"$PORT"} \
  --dir="$DIR" \
  --local="$LOCAL_DIR" \
  --remote="$REMOTE_DIR" \
  --exclude=Merlin \
  --exclude=.thumbnails \
  --exclude=.data \
  --exclude=.cover \
  --pre="$PRE" \
  --post="$POST" \
  "${PASS[@]}"
