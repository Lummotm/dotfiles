{
    "group/extras": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "children-class": "extras",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/menu",
            "tray"
        ]
    },
    "group/brightness": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "children-class": "brightness",
            "transition-left-to-right": false
        },
        "modules": [
            "backlight",
            "backlight/slider"
        ]
    },
    "group/audio": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "children-class": "audio",
            "transition-left-to-right": false
        },
        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },
    "custom/wallpaper": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/rofi/bin/bgselector/bgselector",
    },
    "custom/launcher": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "~/.config/rofi/bin/rofi-launcher.sh",
    },
    "niri/workspaces": {
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "default": "󰄰",
            "active": "󰄯",
        }
    },
    "cpu": {
        "interval": 1,
        "format": "{icon}",
        "format-icons": [
            "<span size='14pt'>⠁</span>",
            "<span size='14pt'>⠉</span>",
            "<span size='14pt'>⠙</span>",
            "<span size='14pt'>⠛</span>",
            "<span size='14pt'>⠟</span>",
            "<span size='14pt'>⠿</span>",
        ],
        "tooltip": true,
        // This tooltip doesnt work either
        "tooltip-format": "Usage: {usage}%",
        "on-click": "kitty -e btm",
    },
    "memory": {
        "interval": 1,
        "format": "{icon}",
        "format-icons": [
            "<span size='14pt'>⠁</span>",
            "<span size='14pt'>⠉</span>",
            "<span size='14pt'>⠙</span>",
            "<span size='14pt'>⠛</span>",
            "<span size='14pt'>⠟</span>",
            "<span size='14pt'>⠿</span>",
        ],
        "tooltip": true,
        "tooltip-format": "Memory Status\n──────────────\nUsage: {percentage}%\nUsed: {used}GiB",
        "on-click": "kitty -e btm",
    },
    "clock": {
        "interval": 5,
        "format": "{:%H\n%M}",
        "format-alt": "{:%d\n%m\n%y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "mpris": {
        "format": "<span size='14pt'>󰐎</span>",
        "player-appearance-order": ["mpd", "firefox", "zen"],
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "tooltip": true,
        // Can't use colors on mpris due to a bug with waybar
        "tooltip-format": "󰎆 {player}\n──────────────\n󰎈 {title}\n󰠃 {artist}",
        "tooltip-format-paused": "󰏤 PAUSED\n──────────────\n󰎈 {title}\n󰠃 {artist}"
    },
    "custom/menu": {
        "format": "<span size='16pt'>󰅃</span>",
        "tooltip": false
    },
    "tray": {
        "spacing": 16,
        "reverse-direction": true,
        "icon-size": 16,
        "show-passive-items": false
    },
    "privacy": {
        "icon-size": 14,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": false,
            }
        ],
        "ignore": [
            {
                "type": "screenshare",
                "name": "obs"
            }
        ]
    },
    "network": {
        "format-icons": {
            "wifi": [
                "<span size='12pt'>󰤯</span>",
                "<span size='12pt'>󰤟</span>",
                "<span size='12pt'>󰤢</span>",
                "<span size='12pt'>󰤥</span>",
                "<span size='12pt'>󰤨</span>"
            ],
            "ethernet": "<span size='12pt'>󰈀</span>",
            "disabled": "<span size='12pt'>󰤭</span>",
            "disconnected": "<span size='12pt'>󰤩</span>",
            "linked": "<span size='12pt'>󱘖</span>",
        },
        "format-wifi": "{icon}",
        "format-ethernet": "{icon}",
        "format-linked": "{icon}",
        "format-disconnected": "{icon}",
        "format-disabled": "{icon}",
        "interval": 5,
        "tooltip-format": "{essid}\t{gwaddr}",

        "tooltip-format-wifi": "{icon} Connected to : <span color='#89b4fa' weight='bold'>{essid}</span>\nIP: {ipaddr}\nSignal: {signaldBm}dBm",
        "tooltip-format-ethernet": "{icon} Connected to <b>Ethernet</b>\nIP: {ipaddr}",
        "tooltip-format-linked": "{icon} <span color='#f9e2af' weight='bold'>VPN Active</span>\nInterface: {ifname}",
        "tooltip-format-disconnected": "<span color='#f38ba8'>Disconnected</span>",

        "on-click": "$HOME/.config/rofi/bin/ronema/rofi-network.sh",
        "tooltip": true,
        "max-length": 20
    },
    "bluetooth": {
        "interval": 5,
        "format-on": "<span size='14pt'>󰂯</span>",
        "format-off": "<span size='14pt'>󰂲</span>",
        "format-disabled": "<span size='14pt'>󰂲</span>",
        "format-connected": "<span size='14pt'>󰂱</span>",
        "format-no-controller": "<span size='14pt'>󰂯</span>",
        "tooltip": true,

        "tooltip-format": "<span color='#89b4fa' weight='bold'>󰂯 Bluetooth</span>\nStatus: {status}",
        "tooltip-format-connected": "<span color='#89b4fa' weight='bold'>󰂱 Connected</span>\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  <span color='#6c7086'>|</span>  <span color='#a6e3a1'>󰁹 {device_battery_percentage}%</span>",

        "on-click": "$HOME/.config/rofi/bin/rofi-bluetooth.sh"
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "<span size='14pt'>󰍬</span>",
        "format-source-muted": "<span size='14pt'>󰍭</span>",
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-click-right": "pavucontrol -t 4",
        "tooltip": false
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "vertical"
    },
    "pulseaudio": {
        "interval": 5,
        "format": "{icon}",
        "format-icons": [
            "<span size='14pt'>󰕿</span>",
            "<span size='14pt'>󰖀</span>",
            "<span size='14pt'>󰕾</span>"
        ],
        "format-muted": "<span size='14pt'>󰝟</span>",
        "on-click-right": "$HOME/.config/rofi/bin/rofi-volume.sh",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "reverse-scrolling": true,
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%\n{desc}",
        "ignored-sinks": [
            "Easy Effects Sink"
        ]
    },
    "backlight/slider": {
        "min": 0,
        "max": 100,
        "orientation": "vertical",
    },
    "backlight": {
        "format": "{icon}",
        "format-icons": [
            "󰃚",
            "󰃛",
            "󰃜",
            "󰃝",
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "reverse-scrolling": true,
        "smooth-scrolling-threshold": 0.2,
        "tooltip": false
    },
    "battery": {
        "interval": 5,
        "states": {
            "critical": 10
        },
        "format": "{icon}",
        "format-icons": [
            "<span size='14pt'>󰁺</span>",
            "<span size='14pt'>󰁻</span>",
            "<span size='14pt'>󰁼</span>",
            "<span size='14pt'>󰁽</span>",
            "<span size='14pt'>󰁾</span>",
            "<span size='14pt'>󰁿</span>", "<span size='14pt'>󰂀</span>",
            "<span size='14pt'>󰂁</span>",
            "<span size='14pt'>󰂂</span>",
            "<span size='14pt'>󰁹</span>"
        ],
        "format-charging": "<span size='14pt'>󰂄</span>",
        "format-plugged": "<span size='14pt'>󰚥</span>",
        "format-critical": "<span size='14pt'>󰂃</span>",
        "tooltip": true,

        "tooltip-format": "<span color='#a6e3a1' weight='bold'>󰁹 Battery Status</span>\n<span color='#f9e2af'>Remaining:</span> {capacity}%\n<span color='#6c7086'>Time:</span> {time}",
        "tooltip-format-charging": "<span color='#89b4fa' weight='bold'>󰂄 Charging</span>\n<span color='#f9e2af'>Current:</span> {capacity}%\n<span color='#6c7086'>Full in:</span> {time}",
        "tooltip-format-plugged": "<span color='#89b4fa' weight='bold'>󰚥 Power Source</span>\n<span color='#a6e3a1'>Fully Charged</span>",
        "tooltip-format-critical": "<span color='#f38ba8' weight='bold'>󰂃 CRITICAL</span>\n<span color='#f38ba8' weight='bold'>Low Battery:</span> {capacity}%\n<span color='#fab387'>Save your work!</span>"

    },
    "custom/powermenu": {
        "format": "<span size='13pt'>󰐥</span>",
        "on-click": "$HOME/.config/rofi/bin/powermenu/rofi-power.sh",
        "tooltip": false
    },
    "custom/updates": {
        "format": "{text}",
        "return-type": "json",
        "exec": "~/bin/ui/waybar-update-count.sh",
        "interval": 600,            
        "on-click": "kitty -e safe-update", 
        "signal": 1                
    }
}
