
configuration {
    show-icons: false;
}


@import "~/.cache/wal/colors-rofi-dark.rasi"

* {
    font: "JetBrains Mono Nerd Font 12";
    box-spacing: 70px;
    box-margin: 300px 350px;
    message-margin: 0px 400px;
    inputbar-spacing: 0px;
    list-spacing: 40px;
    general-padding: 20px;
    element-padding: 60px 10px;
    element-radius: 80px;
    general-radius: 100%;
    element-font: "feather 50";
    background-overlay: #0b040495;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: true;
    width: 1366px;

    enabled: true;
    margin: 0px;
    padding: 0px;
    border: 0px solid;
    border-radius: 0px;
    border-color: @selected-normal-background;
    cursor: "default";
    background-color: @background-overlay;
}

mainbox {
    enabled: true;
    spacing: var(box-spacing);
    margin: 0px;
    padding: var(box-margin);
    border: 0px solid;
    border-radius: 0px;
    border-color: @selected-normal-background;
    background-color: transparent;
    children: [ "inputbar", "listview", "message" ];
}

inputbar {
    enabled: true;
    spacing: var(inputbar-spacing);
    margin: 0px;
    padding: 0px;
    border: 0px;
    border-radius: 0px;
    border-color: @selected-normal-background;
    background-color: transparent;
    text-color: @normal-foreground;
    children: [ "textbox-prompt-colon" ];
}

textbox-prompt-colon {
    enabled: true;
    expand: false;
    str: "SYSTEM";
    padding: var(general-padding);
    border-radius: var(general-radius);
    background-color: @urgent-background;
    text-color: @foreground;
}

prompt {
    enabled: true;
    padding: var(general-padding);
    border-radius: var(general-radius);
    background-color: @active-background;
    text-color: @foreground;
}

message {
    enabled: true;
    margin: var(message-margin);
    padding: var(general-padding);
    border: 0px;
    border-radius: var(general-radius);
    border-color: @selected-normal-background;
    background-color: @alternate-normal-background;
    text-color: @normal-foreground;
}

textbox {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    placeholder-color: @foreground;
    blink: true;
    markup: true;
}

error-message {
    padding: var(general-padding);
    border: 0px solid;
    border-radius: var(general-radius);
    border-color: @selected-normal-background;
    background-color: @background;
    text-color: @foreground;
}

listview {
    enabled: true;
    columns: 5;
    lines: 1;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;

    spacing: var(list-spacing);
    margin: 0px;
    padding: 0px;
    border: 0px solid;
    border-radius: 0px;
    border-color: @selected-normal-background;
    background-color: transparent;
    text-color: @normal-foreground;
    cursor: "default";
}


element {
    enabled: true;
    spacing: 0px;
    margin: 0px;
    padding: var(element-padding);
    border: 0px solid;
    border-radius: var(element-radius);
    border-color: @selected-normal-background;
    background-color: @alternate-normal-background;
    text-color: @normal-foreground;
    cursor: pointer;
}

element-text {
    font: var(element-font);
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0;
    horizontal-align: 0.5;
}

element selected.normal {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

/* Fix para pywal */
listview, mode-switcher, message {
    border: 0;
    border-color: transparent;
}
